# Copy to .env.local (git-ignored) and fill in. `pnpm dev` and `pnpm db:migrate`
# both read .env, .env.local, .env.development and .env.development.local, later files winning.
# Real environment variables always override these files.

# --- Required -------------------------------------------------------------------------------

# PostgreSQL connection string (postgres:// or postgresql://). Remote hosts use TLS automatically.
DATABASE_URL=postgres://user:password@localhost:5432/agent_ops
# Redis connection string (redis:// or rediss://).
REDIS_URL=redis://localhost:6379
# Session signing secret, at least 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this app. Must match the URL you open in the browser (dev server: port 5555).
BETTER_AUTH_URL=http://127.0.0.1:5555

# --- Isolation (optional; use when sharing a database or Redis with other runs) --------------

# Schema for all tables and the migration journal (^[a-z_][a-z0-9_]*$). Created by `pnpm db:migrate`.
# DATABASE_SEARCH_PATH=dev
# Prefix for every Redis key (default: agent-ops:).
# REDIS_KEY_PREFIX=dev:

# --- Optional -------------------------------------------------------------------------------

# PORT=3000
# HOST=127.0.0.1

# GitHub, Slack and the LLM provider (Anthropic) are configured on /settings, not here.
