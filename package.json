  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsrs --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/adapters/db/migrate-cli.ts",
    "llm:ping": "tsx scripts/llm-ping.ts",
    "slack:review": "tsx scripts/slack-review-worker.ts",
    "slack:review:retry": "tsx scripts/slack-review-retry.ts",
    "test": "vitest run --project unit --project db-fast --project component",
    "test:watch": "vitest --project unit --project db-fast --project component",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage"
  },
