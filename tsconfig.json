{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "paths": { "@/*": ["./src/*"] },
    "types": ["node", "vite/client", "unplugin-icons/types/react"]
  },
  "include": ["src", "tests", "scripts", "vite.config.ts"],
  "exclude": [
    "node_modules",
    ".output",
    "src/app",
    "src/components/**",
    "src/lib/slack-review-vercel.ts"
  ]
}
